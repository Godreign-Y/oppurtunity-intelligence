-- =========================================================
-- 5. OPPORTUNITY PRACTICE MAPPING
-- =========================================================
 
CREATE TABLE opportunity_practice_mapping (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
 
    opportunity_id UUID REFERENCES opportunities(id) ON DELETE CASCADE,
 
    practice_id UUID REFERENCES practices(id) ON DELETE CASCADE,
 
    relevance_score INTEGER CHECK (relevance_score BETWEEN 1 AND 10),
 
    mapping_type VARCHAR(50),
 
    execution_dependency TEXT,
 
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
 
-- =========================================================
-- SEED OPPORTUNITY ↔ PRACTICE RELATIONS
-- =========================================================
 
INSERT INTO opportunity_practice_mapping (
    opportunity_id,
    practice_id,
    relevance_score,
    mapping_type,
    execution_dependency
)
 
SELECT
    o.id,
    p.id,
 
    CASE
 
        WHEN o.opportunity_code = 'OPP_AI_INFRA'
        AND p.practice_code IN ('PRA_DATA_AI', 'PRA_AI_LAB')
        THEN 10
 
        WHEN o.opportunity_code = 'OPP_MLOPS'
        AND p.practice_code IN ('PRA_DATA_AI', 'PRA_AI_LAB')
        THEN 10
 
        WHEN o.opportunity_code = 'OPP_DEVOPS'
        AND p.practice_code = 'PRA_DIGITAL'
        THEN 10
 
        WHEN o.opportunity_code = 'OPP_CLOUD_MIGRATION'
        AND p.practice_code = 'PRA_DIGITAL'
        THEN 10
 
        WHEN o.opportunity_code = 'OPP_LEGACY'
        AND p.practice_code = 'PRA_DIGITAL'
        THEN 9
 
        WHEN o.opportunity_code = 'OPP_COST_OPT'
        AND p.practice_code IN ('PRA_DIGITAL', 'PRA_PLANNING')
        THEN 8
 
        WHEN o.opportunity_code = 'OPP_AI_INFRA'
        AND p.practice_code = 'PRA_PLANNING'
        THEN 7
 
        ELSE 6
 
    END,
 
    'Primary',
 
    'Strategic execution dependency'
 
FROM opportunities o
CROSS JOIN practices p;
 
