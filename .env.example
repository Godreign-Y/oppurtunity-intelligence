# Application
APP_NAME=redit
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reddit ingestion: public_json (default) | praw (future)
REDDIT_SOURCE=public_json
REDDIT_USER_AGENT=redit-pain-intel/0.1 (contact: you@example.com)
REDDIT_REQUEST_TIMEOUT_SECONDS=30
REDDIT_REQUEST_DELAY_SECONDS=1.0

# Global discovery feeds: all,popular
DISCOVERY_FEEDS=all,popular

# Search queries (pipe-separated)
DISCOVERY_SEARCH_QUERIES=AI SaaS software frustration|LLM API tool complaint

# Pipeline thresholds
MIN_TEXT_LENGTH=50
MIN_UPVOTES=5
RECENCY_DAYS=30

# Semantic / frustration / business
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
TECH_SIMILARITY_MIN=0.32
TECH_SIMILARITY_MARGIN_MIN=0.05
FRUSTRATION_DETECTION_THRESHOLD=0.55
MIN_BUSINESS_RELEVANCE=0.2

# Database (Neon) — Phase 2+
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Reddit API (PRAW) — future swap when credentials available
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
