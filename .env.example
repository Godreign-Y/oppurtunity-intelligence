# =====================================================================
# AI Opportunity Intelligence Platform - Environment Variables
# =====================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =====================================================================

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO
LOG_FILE=/var/log/opp-intel/pipeline.log

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# --- CORS & Security ---
# Comma-separated. Add your production frontend domain.
CORS_ORIGINS=https://your-frontend-domain.com
TRUSTED_HOSTS=your-api-domain.com,your-frontend-domain.com
SECURITY_HEADERS_ENABLED=true
ENFORCE_HTTPS=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SALT=change-to-random-32-char-string

# --- LLM (NVIDIA NIM) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=meta/llama-3.3-70b-instruct

# --- GitHub ---
GITHUB_TOKEN=ghp_...

# --- Hiring (SerpApi) ---
SERPAPI_API_KEY=

# --- Search APIs ---
TAVILY_API_KEY=tvly-...
SERPER_API_KEY=

# --- Web Extraction ---
FIRECRAWL_API_KEY=fc-...

# --- Reddit (PRAW) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OppIntel/1.0
